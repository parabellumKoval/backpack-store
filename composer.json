{
    "name": "parabellumkoval/backpack-store",
    "description": "Implement Products API & MYSQL for dackpack",
    "keywords": [
        "parabellumKoval",
        "backpack",
        "laravel",
        "products"
    ],
    "homepage": "https://github.com/parabellumkoval/products",
    "license": "MIT",
    "authors": [
      {
        "name": "parabellumKoval",
        "email": "parabellum.koval@gmail.com",
        "role": "Developer"
      }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^8.75 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        
        "parabellumkoval/request-data": "0.1.x-dev",

        "cviebrock/eloquent-sluggable": "^8.0 || ^12.0",
        "spatie/laravel-translatable": "^5.1 || ^6.0",
        "laravel/scout": "^9.0 || ^10.0",
        "dompdf/dompdf": "^2.0",
        "bacon/bacon-qr-code": "^2.0",

        "meilisearch/meilisearch-php": "^1.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^11.0",
        "orchestra/testbench": "^6.0"
    },
    "autoload": {
      "psr-4": {
        "App\\": "src/app/",
        "Backpack\\Store\\": "src",
        "Backpack\\Store\\Database\\Factories\\": "database/factories"
      }
    },
    "autoload-dev": {
      "psr-4": {
        "App\\": "src/app/",
        "Backpack\\Store\\Tests\\": "tests"
      }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "phpunit": "vendor/bin/phpunit --testdox"
    },
    "config": {
        "sort-packages": true,
        "platform": {
          "php": "8.3.0"
        },
        "allow-plugins": {
          "pestphp/pest-plugin": true,
          "phpstan/extension-installer": true
        }
    },
    "extra": {
      "laravel": {
        "providers": [
          "Backpack\\CRUD\\BackpackServiceProvider",
          "Backpack\\Store\\ServiceProvider"
        ],
        "aliases": {
          "Store": "Backpack\\Store\\Facades\\Store",
          "CRUD": "Backpack\\CRUD\\app\\Library\\CrudPanel\\CrudPanelFacade"
        }
      }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
